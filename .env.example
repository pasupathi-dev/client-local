# ─────────────────────────────────────────────────────────────
# ServiceLink — CLIENT environment template (Vite)
# Copy this file to .env and fill in the values for your environment.
# Only VITE_-prefixed vars are exposed to the browser bundle — anything
# secret (Razorpay secret, Firebase service account, SMTP, etc) stays
# in server/.env only.
#
# IMPORTANT: After changing this file, restart `npm run dev` — Vite
# only reads env at boot.
# ─────────────────────────────────────────────────────────────

# ── API base ─────────────────────────────────
# Where the React app sends API requests / opens the websocket.
# Defaults are coded in src/constants/api.js if these are blank
# (auto-derives from window.location.hostname so LAN devices work).
#
# IMPORTANT: VITE_API_URL must include the `/api/` suffix. Every
# request is built as `${BASE_URL}<endpoint>`, so a value without
# `/api/` would send POST /auth/sync (404) instead of POST /api/auth/sync.
# VITE_SOCKET_URL is the bare origin (no /api/).
VITE_API_URL=http://localhost:5000/api/
VITE_SOCKET_URL=http://localhost:5000

# HTTP request timeout (ms). Raise to 30000 for slow / tunnel networks.
VITE_API_TIMEOUT_MS=10000

# ── Firebase Web SDK ─────────────────────────
# From: Firebase Console → Project Settings → General →
#   "Your apps" → Web app → Config object
# These values are public (they identify your project to the SDK) —
# security lives in Firebase Auth rules + your server token check.
#
# ⚠️  If you change these, you MUST also update the inlined config in
#     client/public/firebase-messaging-sw.js — service workers run
#     outside Vite so they can't read import.meta.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── FCM Web Push ─────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging
#   → Web configuration → "Generate key pair" / Web Push certificates
# Without this set, push notifications silently no-op and the app
# falls back to in-app socket notifications only.
VITE_FCM_VAPID_KEY=

# ── Google Maps (client maps + place search) ─
# Required APIs: Maps JavaScript API, Places API.
# For production: restrict this key by HTTP referrer to your domain.
VITE_GOOGLE_MAPS_API_KEY=

# ── Razorpay ─────────────────────────────────
# Checkout key id — safe to expose to the browser. The secret stays
# server-side only. If this rotates, update both .envs together.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# ── Support contacts (Help page CTAs) ────────
# Shown on /help and in the "Contact support" flow. Defaults are
# baked into HelpPage.jsx so missing values won't break the build.
# WhatsApp number must be in international format WITHOUT the "+".
VITE_SUPPORT_WHATSAPP=919876543210
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_SUPPORT_EMAIL=help@servicelink.in
